      "rgba(64,120,255,.55)",
      "rgba(0,200,170,.30)",
      "rgba(120,90,255,.35)"
    ],
    "dots": "rgba(255,255,255,.06)",
    "vignette": "rgba(0,4,12,.62)",
    "text": "#ffffff",
    "muted": "#b9c6d8",
    "accent": "#4d8dff",
    "accentText": "#ffffff",
    "kicker": "#8fb4ff",
    "card": "rgba(10,22,42,.74)",
    "cardLine": "rgba(255,255,255,.16)",
    "cardText": "#ffffff",
    "cardMuted": "#b9c6d8",
    "dim": "rgba(2,10,24,.55)",
    "shadow": "rgba(0,0,0,.6)"
  },
  "background": {
    "glow": 0.9
  },
  "fonts": {
    "display": {
      "family": "Inter",
      "src": "engines/gsap/fonts/Inter.ttf"
