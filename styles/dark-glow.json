{
  "name": "dark-glow",
  "description": "Cinematic near-black, brand glows, particles, grain, heavy Inter Black + serif-italic keyword, letters rise from a mask with blur. (The original look; use sparingly.)",
  "theme": "dark",
  "roles": {},
  "background": {
    "type": "glow",
    "particles": 70,
    "grain": 0.07,
    "vignette": true
  },
  "fonts": {
    "display": {
      "family": "Inter",
      "src": "engines/gsap/fonts/Inter.ttf",
      "weight": 900,
      "tracking": -0.045,
      "transform": "none",
      "lineHeight": 1.1
    },
    "keyword": {
      "family": "ISerif",
      "src": "engines/gsap/fonts/ISerif.ttf",
      "style": "italic",
      "weight": 400
    },
    "label": {
      "family": "Inter",
      "src": "engines/gsap/fonts/Inter.ttf",
      "weight": 700
    }
  },
  "text": {
    "enter": "rise-blur",
    "align": "center",
    "sticker": false,
    "keyword": "gradient"
  },
  "motion": {
    "enter": "expo.out",
    "overshoot": "back.out(1.4)",
    "camera": "expo.inOut",
    "blur": 14,
    "tilt": 1
  },
  "transition": {
    "type": "overlap",
    "overlap": 0.35
  },
  "device": {
    "shadow": "soft"
  },
  "post": {
    "glowPass": true,
    "noise": 5
  },
  "audio": {
    "music": "cinematic",
    "bpm": 120
  }
}