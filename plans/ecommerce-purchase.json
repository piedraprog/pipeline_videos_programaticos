{
  "projectName": "ecommerce-purchase",
  "title": "DemoBlaze",
  "subtitle": "From discovery to cart",
  "visual": {
    "accentColor": "#67e8c1",
    "backgroundStyle": "aurora"
  },
  "baseUrl": "https://www.demoblaze.com/",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "fps": 30,
  "scenes": [
    {
      "id": "storefront",
      "title": "Explore the storefront",
      "caption": "Browse the catalog and discover what is available.",
      "durationFrames": 90,
      "actions": [
        {
          "type": "waitFor",
          "selector": ".hrefch"
        },
        {
          "type": "scroll",
          "selector": ".card"
        },
        {
          "type": "screenshot"
        }
      ]
    },
    {
      "id": "product-detail",
      "title": "Discover product details",
      "caption": "Move from the catalog into a product page.",
      "durationFrames": 90,
      "actions": [
        {
          "type": "click",
          "selector": ".hrefch"
        },
        {
          "type": "waitFor",
          "selector": "h2.name",
          "text": "Samsung galaxy s6"
        },
        {
          "type": "waitFor",
          "selector": "#imgp img"
        },
        {
          "type": "screenshot"
        }
      ]
    },
    {
      "id": "cart",
      "title": "Review the cart",
      "caption": "Confirm the selected product and total.",
      "durationFrames": 90,
      "actions": [
        {
          "type": "click",
          "selector": "a.btn.btn-success.btn-lg",
          "dialog": {
            "message": "Product added"
          }
        },
        {
          "type": "navigate",
          "url": "https://www.demoblaze.com/cart.html"
        },
        {
          "type": "waitFor",
          "selector": "#tbodyid tr",
          "text": "Samsung galaxy s6"
        },
        {
          "type": "screenshot"
        }
      ]
    }
  ]
}
