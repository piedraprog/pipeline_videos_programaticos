          "selector": ".hrefch"
        },
        {
          "type": "screenshot"
        }
      ]
    },
    {
      "id": "cart",
      "title": "Review the cart",
      "caption": "Show the final step of the purchase journey.",
      "durationFrames": 90,
      "actions": [
        {
          "type": "click",
          "selector": "a.btn.btn-success.btn-lg"
